# Supabase Credentials (from your existing CRM Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# NVIDIA NIM API (cuts running costs down to zero with free credits!)
# Get your free key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenAI API (Optional fallback if NVIDIA_API_KEY is not set)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# -------------------------------------------------------------
# ACADEMY MULTI-EMAIL CONFIGURATION (IMAP / SMTP)
# -------------------------------------------------------------
# 1. Reception & Parent Inquiries: info@tynesideacademy.com
INFO_EMAIL_USER=info@tynesideacademy.com
INFO_EMAIL_PASS=your_info_password
INFO_EMAIL_HOST=mail.tynesideacademy.com
INFO_EMAIL_PORT=993

# 2. Invoices & Administration: admin@tynesideacademy.com
ADMIN_EMAIL_USER=admin@tynesideacademy.com
ADMIN_EMAIL_PASS=your_admin_password
ADMIN_EMAIL_HOST=mail.tynesideacademy.com
ADMIN_EMAIL_PORT=993

# 3. Secretary & Absences: secretaria@tynesideacademy.com
SECRETARIA_EMAIL_USER=secretaria@tynesideacademy.com
SECRETARIA_EMAIL_PASS=your_secretaria_password
SECRETARIA_EMAIL_HOST=mail.tynesideacademy.com
SECRETARIA_EMAIL_PORT=993

# 4. Academy Operations: academia@tynesideacademy.com
ACADEMIA_EMAIL_USER=academia@tynesideacademy.com
ACADEMIA_EMAIL_PASS=your_academia_password
ACADEMIA_EMAIL_HOST=mail.tynesideacademy.com
ACADEMIA_EMAIL_PORT=993

# 5. Google Workspace / Gmail Backup: tynesideenglishacademy@gmail.com
GMAIL_USER=tynesideenglishacademy@gmail.com
GMAIL_APP_PASS=your_gmail_app_password
GMAIL_HOST=imap.gmail.com
GMAIL_PORT=993
